# Скопируйте этот файл в .env и при необходимости измените значения.
# Файл .env не попадает в git и в докер-образ.

# ---------- Общие настройки сервера ----------

# Порт веб-сервера (по умолчанию 7540). В docker compose — порт на хосте.
TODO_PORT=7540

# Пароль для входа. Пустое значение — вход без пароля.
TODO_PASSWORD=

# ---------- Хранилище ----------

# Вариант 1: SQLite (по умолчанию, нужен для тестов из директории tests).
# Путь к файлу базы данных; по умолчанию scheduler.db в текущей директории.
TODO_DBFILE=scheduler.db

# Вариант 2: PostgreSQL. Если строка подключения не пустая, SQLite не используется.
# Формат:  postgres://<пользователь>:<пароль>@<хост>:<порт>/<база>?sslmode=disable
#   пользователь, пароль и база — те же, что в POSTGRES_USER, POSTGRES_PASSWORD
#   и POSTGRES_DB ниже; хост и порт — где слушает PostgreSQL.
#
# Для контейнера app эта переменная не нужна: docker compose собирает DSN сам,
# с хостом db. Она нужна только для локального `go run main.go` против
# PostgreSQL, например поднятого через `docker compose up -d db`
# (порт 5432 проброшен на localhost). Раскомментируйте строку и подставьте пароль:
# TODO_POSTGRES_DSN=postgres://todo:secret@localhost:5432/todo?sslmode=disable
#
# Пустое значение — используется SQLite (нужно для тестов из директории tests).
TODO_POSTGRES_DSN=

# ---------- Настройки PostgreSQL для docker compose ----------
# Из них же собирается TODO_POSTGRES_DSN для контейнера приложения.
POSTGRES_USER=todo
POSTGRES_PASSWORD=secret
POSTGRES_DB=todo
